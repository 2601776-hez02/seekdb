# expected output is generated on first run: mysqltest --record
drop table if exists t_ai_ddl;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_embed_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_embed_model');
MOCK STOPPED
MOCK READY
MOCK RESET
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'mock_doc_model', '{
    "type": "completion",
    "model_name": "mock-complete"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'mock_embed_model', '{
    "type": "dense_embedding",
    "model_name": "mock-embed"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
'mock_doc_endpoint', '{
    "ai_model_name": "mock_doc_model",
    "url": "http://127.0.0.1:19120/v1/chat/completions",
    "access_key": "sk-mock",
    "request_model_name": "mock-complete",
    "provider": "openai"
  }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
'mock_embed_endpoint', '{
    "ai_model_name": "mock_embed_model",
    "url": "http://127.0.0.1:19120/v1/embeddings",
    "access_key": "sk-mock",
    "request_model_name": "mock-embed",
    "provider": "openai"
  }');
create table t_ai_ddl (
id       bigint primary key,
content  varchar(8192),
language varchar(32) AI COLUMN (
AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=LANG]] Return only the language name. Content: ', content))
) WITH (sync_mode='async', max_retries=3)
);
show ai columns from t_ai_ddl;
Table	Column	AIFunction	ModelName	ResultType	Dependencies	SyncMode	MaxRetries	StatusColumn	DefVersion
t_ai_ddl	language	AI_COMPLETE	mock_doc_model	VARCHAR	NULL	async	3	__ai_status_language	1
show create table t_ai_ddl;
Table	Create Table
t_ai_ddl	CREATE TABLE `t_ai_ddl` (
  `id` bigint(20) NOT NULL,
  `content` varchar(8192) DEFAULT NULL,
  `language` varchar(32) DEFAULT 'AI_COMPLETE(\'mock_doc_model\', CONCAT(\'[[OUT=LANG]] Return only the language name. Content: \', content))',
  PRIMARY KEY (`id`)
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
drop table t_ai_ddl;
create table t_ai_ddl (
id       bigint primary key,
title    varchar(255),
content  varchar(8192),
language varchar(32) AI COLUMN (
AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=LANG]] Return only the language name. Content: ', content))
) WITH (sync_mode='async', max_retries=3),
tags json AI COLUMN (
AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=TAGS]] Tags for: ', content))
) WITH (sync_mode='async', max_retries=3),
emb vector(4) AI COLUMN (
AI_EMBED('mock_embed_model', content, 4)
) WITH (sync_mode='async', max_retries=5)
);
show ai columns from t_ai_ddl;
Table	Column	AIFunction	ModelName	ResultType	Dependencies	SyncMode	MaxRetries	StatusColumn	DefVersion
t_ai_ddl	language	AI_COMPLETE	mock_doc_model	VARCHAR	18	async	3	__ai_status_language	1
t_ai_ddl	tags	AI_COMPLETE	mock_doc_model	JSON	18	async	3	__ai_status_tags	1
t_ai_ddl	emb	AI_EMBED	mock_embed_model	VECTOR(4)	18	async	5	__ai_status_emb	1
show ai columns in t_ai_ddl;
Table	Column	AIFunction	ModelName	ResultType	Dependencies	SyncMode	MaxRetries	StatusColumn	DefVersion
t_ai_ddl	language	AI_COMPLETE	mock_doc_model	VARCHAR	18	async	3	__ai_status_language	1
t_ai_ddl	tags	AI_COMPLETE	mock_doc_model	JSON	18	async	3	__ai_status_tags	1
t_ai_ddl	emb	AI_EMBED	mock_embed_model	VECTOR(4)	18	async	5	__ai_status_emb	1
