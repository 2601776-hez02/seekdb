t_ai_ddl	CREATE TABLE `t_ai_ddl` (
  `id` bigint(20) NOT NULL,
  `title` varchar(255) DEFAULT NULL,
  `content` varchar(8192) DEFAULT NULL,
  `language` varchar(32) DEFAULT 'AI_COMPLETE(\'mock_doc_model\', CONCAT(\'[[OUT=LANG]] Return only the language name. Content: \', content))',
  `tags` json DEFAULT 'null',
  `emb` VECTOR(4) DEFAULT 'AI_EMBED('mock_embed_model', content, 4)',
  PRIMARY KEY (`id`)
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
