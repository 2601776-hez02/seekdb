MOCK RESET
MOCK CONFIG OK
insert into t_ai_retry (id, content, status) values
(50, '[[LANG=Korean]] pending row', 'active');
set session ai_column_strict_read = on;
show variables like 'ai_column_strict_read';
Variable_name	Value
ai_column_strict_read	ON
