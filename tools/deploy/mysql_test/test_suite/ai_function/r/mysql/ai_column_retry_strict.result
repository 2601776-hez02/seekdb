# expected output is generated on first run: mysqltest --record
drop table if exists t_ai_retry;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');
MOCK STOPPED
MOCK READY
MOCK RESET
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'mock_doc_model', '{
    "type": "completion",
    "model_name": "mock-complete"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
'mock_doc_endpoint', '{
    "ai_model_name": "mock_doc_model",
    "url": "http://127.0.0.1:19120/v1/chat/completions",
    "access_key": "sk-mock",
    "request_model_name": "mock-complete",
    "provider": "openai"
  }');
create table t_ai_retry (
id       bigint primary key,
content  varchar(8192),
status   varchar(16),
language varchar(32) AI COLUMN (
AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=LANG]] Return only the language name. Content: ', content))
) WITH (sync_mode='async', max_retries=2)
);
show ai columns from t_ai_retry;
Table	Column	AIFunction	ModelName	ResultType	Dependencies	SyncMode	MaxRetries	StatusColumn	DefVersion
t_ai_retry	language	AI_COMPLETE	mock_doc_model	VARCHAR	NULL	async	2	__ai_status_language	1
insert into t_ai_retry (id, content, status) values
(1, '[[LANG=Japanese]] alpha', 'active'),
(2, '[[LANG=English]] beta', 'active'),
(3, '[[LANG=French]] #fail gamma', 'archived');
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry failed ai column language;
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry ai column language;
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry failed ai column language where id = 3;
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry failed ai column language where id = 999;
select count(*) from t_ai_retry where id = 999;
count(*)
0
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry ai column language where status = 'READY';
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry ai column language where `status` = 'archived';
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry failed ai column language where status = 'FAILED' and `status` = 'archived';
select id, language, status from t_ai_retry order by id;
id	language	status
1	Japanese	active
2	English	active
3	NULL	archived
alter table t_ai_retry retry ai column no_such_column;
