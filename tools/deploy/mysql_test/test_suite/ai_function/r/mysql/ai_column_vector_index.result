# expected output is generated on first run: mysqltest --record
drop table if exists t_ai_vec;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_embed_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_embed_model');
MOCK STOPPED
MOCK READY
MOCK RESET
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'mock_embed_model', '{
    "type": "dense_embedding",
    "model_name": "mock-embed"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
  'mock_embed_endpoint', '{
    "ai_model_name": "mock_embed_model",
    "url": "http://127.0.0.1:19120/v1/embeddings",
    "access_key": "sk-mock",
    "request_model_name": "mock-embed",
    "provider": "openai"
  }');
create table t_ai_vec (
  id      int primary key,
  content varchar(4096),
  emb     vector(4) AI COLUMN (
    AI_EMBED('mock_embed_model', content, 4)
  ) WITH (sync_mode='async', max_retries=3),
  vector index idx_emb(emb) with (distance=l2, type=hnsw, lib=vsag, m=16, ef_construction=200, ef_search=64)
);
show ai columns from t_ai_vec;
Table	Column	AIFunction	ModelName	ResultType	Dependencies	SyncMode	MaxRetries	StatusColumn	DefVersion
t_ai_vec	emb	AI_EMBED	mock_embed_model	vector(4)	<deps>	async	3	__ai_status_emb	1
show create table t_ai_vec;
Table	Create Table
t_ai_vec	CREATE TABLE `t_ai_vec` (
  `id` int(11) NOT NULL,
  `content` varchar(4096) DEFAULT NULL,
  `emb` VECTOR(4) DEFAULT NULL /* AI COLUMN AI_EMBED('mock_embed_model', content, 4) WITH (sync_mode='async', max_retries=3) */,
  PRIMARY KEY (`id`),
  VECTOR KEY `idx_emb` (`emb`) WITH (DISTANCE=L2, TYPE=HNSW, LIB=VSAG, M=16, EF_CONSTRUCTION=200, EF_SEARCH=64) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
show index from t_ai_vec;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_ai_vec	0	PRIMARY	1	id	A	NULL	NULL	NULL		BTREE	available		YES	NULL
t_ai_vec	1	idx_emb	1	emb	A	NULL	NULL	NULL	YES	VECTOR	available		YES	NULL
drop table t_ai_vec;
create table t_ai_vec (
  id      int primary key,
  content varchar(4096),
  emb     vector(4) AI COLUMN (
    AI_EMBED('mock_embed_model', content, 4)
  ) WITH (sync_mode='async', max_retries=3)
);
create vector index idx_emb on t_ai_vec(emb) with (distance=l2, type=hnsw, lib=vsag, m=16, ef_construction=200, ef_search=64);
show create table t_ai_vec;
Table	Create Table
t_ai_vec	CREATE TABLE `t_ai_vec` (
  `id` int(11) NOT NULL,
  `content` varchar(4096) DEFAULT NULL,
  `emb` VECTOR(4) DEFAULT NULL /* AI COLUMN AI_EMBED('mock_embed_model', content, 4) WITH (sync_mode='async', max_retries=3) */,
  PRIMARY KEY (`id`),
  VECTOR KEY `idx_emb` (`emb`) WITH (DISTANCE=L2, TYPE=HNSW, LIB=VSAG, M=16, EF_CONSTRUCTION=200, EF_SEARCH=64) BLOCK_SIZE 16384
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0
