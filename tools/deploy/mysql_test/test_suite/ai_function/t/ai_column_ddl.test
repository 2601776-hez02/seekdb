#owner: ai-column
#owner group: seekdb
#description: AI COLUMN DDL.  CREATE TABLE with one and with many AI columns,
#             ALTER TABLE ADD|MODIFY AI COLUMN, SHOW AI COLUMNS, SHOW CREATE TABLE,
#             and every definition error the resolver has to reject.
#             No statement of this case may reach the model service: the case
#             asserts that the mock saw zero requests at the end.
#
#require: python3 (>= 3.7) on PATH
#require: AI_COLUMN_MOCK_PORT=19120 - TCP port of the local mock AI service
#         (default 19120; when you override it, also change the two endpoint
#         URLs below, they are the only hard coded port literals)
#require: run from tools/deploy, e.g.
#         ./obd.sh mysqltest -n test --suite ai_function --test-set ai_column_ddl
#
--echo # expected output is generated on first run: mysqltest --record

connection default;

# ---------------------------------------------------------------------------
# self cleaning
# ---------------------------------------------------------------------------
--disable_warnings
drop table if exists t_ai_ddl;
--enable_warnings
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_embed_endpoint');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_embed_model');

# ---------------------------------------------------------------------------
# local mock AI service, logical models and endpoints
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --stop-if-running
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --seed 20250101 --dim 4 > /tmp/ai_column_mock.log 2>&1 &
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --wait-ready
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --reset

call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'mock_doc_model', '{
    "type": "completion",
    "model_name": "mock-complete"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'mock_embed_model', '{
    "type": "dense_embedding",
    "model_name": "mock-embed"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
  'mock_doc_endpoint', '{
    "ai_model_name": "mock_doc_model",
    "url": "http://127.0.0.1:19120/v1/chat/completions",
    "access_key": "sk-mock",
    "request_model_name": "mock-complete",
    "provider": "openai"
  }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
  'mock_embed_endpoint', '{
    "ai_model_name": "mock_embed_model",
    "url": "http://127.0.0.1:19120/v1/embeddings",
    "access_key": "sk-mock",
    "request_model_name": "mock-embed",
    "provider": "openai"
  }');

# ---------------------------------------------------------------------------
# 1. one AI column
# ---------------------------------------------------------------------------
create table t_ai_ddl (
  id       bigint primary key,
  content  varchar(8192),
  language varchar(32) AI COLUMN (
    AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=LANG]] Return only the language name. Content: ', content))
  ) WITH (sync_mode='async', max_retries=3)
);
# NOTE: the Dependencies column of SHOW AI COLUMNS holds the comma separated
# dependency COLUMN IDs (__all_ai_column.dependencies), i.e. a number that
# depends on the schema.  The expected output uses the <deps> placeholder, so
# regenerate this case with --record after the first successful run.
show ai columns from t_ai_ddl;
show create table t_ai_ddl;

# ---------------------------------------------------------------------------
# 2. many AI columns: two text columns and one vector column
# ---------------------------------------------------------------------------
drop table t_ai_ddl;
create table t_ai_ddl (
  id       bigint primary key,
  title    varchar(255),
  content  varchar(8192),
  language varchar(32) AI COLUMN (
    AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=LANG]] Return only the language name. Content: ', content))
  ) WITH (sync_mode='async', max_retries=3),
  tags json AI COLUMN (
    AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=TAGS]] Tags for: ', content))
  ) WITH (sync_mode='async', max_retries=3),
  emb vector(4) AI COLUMN (
    AI_EMBED('mock_embed_model', content, 4)
  ) WITH (sync_mode='async', max_retries=5)
);
show ai columns from t_ai_ddl;
show ai columns in t_ai_ddl;
show create table t_ai_ddl;

# the hidden status / srcver companions must not show up as user columns
select count(*) from information_schema.columns
  where table_name = 't_ai_ddl' and column_name like '\_\_ai\_%';

# ---------------------------------------------------------------------------
# 3. ALTER TABLE ... ADD COLUMN
# ---------------------------------------------------------------------------
alter table t_ai_ddl add column summary varchar(2048) AI COLUMN (
  AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=ECHO]] Summarize: ', content))
) WITH (sync_mode='async', max_retries=3);
show ai columns from t_ai_ddl;
show create table t_ai_ddl;

# ---------------------------------------------------------------------------
# 4. ALTER TABLE ... MODIFY COLUMN: new expression, new type, new max_retries
#    (the definition version must be bumped, see DefVersion in SHOW AI COLUMNS)
# ---------------------------------------------------------------------------
alter table t_ai_ddl modify column summary varchar(4096) AI COLUMN (
  AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=ECHO]] Summarize in one paragraph: ', content))
) WITH (sync_mode='async', max_retries=5);
show ai columns from t_ai_ddl;
show create table t_ai_ddl;

# ---------------------------------------------------------------------------
# 5. SHOW AI COLUMNS error cases
# ---------------------------------------------------------------------------
--error 1146
show ai columns from t_ai_ddl_not_exist;

# ---------------------------------------------------------------------------
# 6. invalid WITH options
#    Every case below uses an ordinary column in the prompt, so the failure
#    really comes from the option check and not from the dependency check.
# ---------------------------------------------------------------------------
--disable_warnings
drop table if exists t_ai_ddl_bad;
--enable_warnings

# only sync_mode='async' is supported
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       varchar(16) AI COLUMN (AI_COMPLETE('mock_doc_model', CONCAT('x:', content))) WITH (sync_mode='sync')
);

# max_retries is an integer in [0, 100]
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       varchar(16) AI COLUMN (AI_COMPLETE('mock_doc_model', CONCAT('x:', content))) WITH (max_retries=-1)
);
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       varchar(16) AI COLUMN (AI_COMPLETE('mock_doc_model', CONCAT('x:', content))) WITH (max_retries=101)
);
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       varchar(16) AI COLUMN (AI_COMPLETE('mock_doc_model', CONCAT('x:', content))) WITH (sync_mode='async', no_such_option=1)
);

# ---------------------------------------------------------------------------
# 7. unknown model
# ---------------------------------------------------------------------------
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       varchar(16) AI COLUMN (AI_COMPLETE('no_such_model', CONCAT('x:', content)))
);

# ---------------------------------------------------------------------------
# 8. AI function / model type mismatch
# ---------------------------------------------------------------------------
# completion function on an embedding model
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       varchar(16) AI COLUMN (AI_COMPLETE('mock_embed_model', CONCAT('x:', content)))
);
# embedding function on a completion model
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       vector(4) AI COLUMN (AI_EMBED('mock_doc_model', content, 4))
);

# ---------------------------------------------------------------------------
# 9. AI_EMBED dimension against the declared VECTOR(N)
# ---------------------------------------------------------------------------
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       vector(4) AI COLUMN (AI_EMBED('mock_embed_model', content, 8))
);
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  c       vector(8) AI COLUMN (AI_EMBED('mock_embed_model', content, 4))
);

# ---------------------------------------------------------------------------
# 10. an AI column may not depend on another AI column
# ---------------------------------------------------------------------------
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
create table t_ai_ddl_bad (
  id      bigint primary key,
  content varchar(64),
  a       varchar(16) AI COLUMN (AI_COMPLETE('mock_doc_model', CONCAT('a:', content))),
  b       varchar(16) AI COLUMN (AI_COMPLETE('mock_doc_model', CONCAT('b:', a)))
);
# the same rule through ALTER TABLE ... ADD COLUMN
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 4002
alter table t_ai_ddl add column bad_c varchar(16) AI COLUMN (
  AI_COMPLETE('mock_doc_model', CONCAT('x:', language))
);

# ---------------------------------------------------------------------------
# 11. a user statement may not assign an AI column
#    (OB_NON_DEFAULT_VALUE_FOR_GENERATED_COLUMN = 5290, reused on purpose)
# ---------------------------------------------------------------------------
--error 5290
insert into t_ai_ddl (id, content, language) values (1, 'hello', 'English');
--error 5290
insert into t_ai_ddl values (1, 'title', 'hello', 'English', '[]', '[1,0,0,0]', 'summary');
--error 5290
update t_ai_ddl set language = 'English' where id = 1;
--error 5290
update t_ai_ddl set emb = '[1,0,0,0]' where id = 1;
--error 5290
update t_ai_ddl set tags = json_array('a'), content = 'x' where id = 1;

# NOTE: a legal INSERT (ordinary columns only) is covered by ai_column_t1_dml.test.
# It is not repeated here on purpose: this case asserts that DDL alone never
# reaches the model service, and a legal INSERT does create a generation task.

# ---------------------------------------------------------------------------
# 12. DDL never calls the model service
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --print-state

# ---------------------------------------------------------------------------
# self cleaning
# ---------------------------------------------------------------------------
--disable_warnings
drop table if exists t_ai_ddl;
drop table if exists t_ai_ddl_bad;
--enable_warnings
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_embed_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_embed_model');
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --stop
