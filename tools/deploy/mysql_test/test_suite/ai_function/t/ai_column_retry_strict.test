#owner: ai-column
#owner group: seekdb
#description: AI COLUMN retry statement and strict read.
#             ALTER TABLE ... RETRY [FAILED] AI COLUMN ... with and without a
#             WHERE clause, the status pseudo column versus a real column named
#             `status`, the zero row retry, illegal RETRY syntax, and the
#             column level check of ai_column_strict_read.
#
#require: python3 (>= 3.7) on PATH
#require: AI_COLUMN_MOCK_PORT=19120 - TCP port of the local mock AI service
#         (default 19120; when you override it, also change the endpoint URLs
#         below, they are the only hard coded port literals)
#require: run from tools/deploy, e.g.
#         ./obd.sh mysqltest -n test --suite ai_function --test-set ai_column_retry_strict
#
# Row 3 fails forever on purpose: the mock answers HTTP 500 whenever the prompt
# contains the "#fail" marker, so it reaches the FAILED terminal state and
# stays there.  That is what RETRY and RETRY FAILED are exercised against.
#
--echo # expected output is generated on first run: mysqltest --record

connection default;

--let $wait_timeout= 60

# ---------------------------------------------------------------------------
# self cleaning
# ---------------------------------------------------------------------------
--disable_warnings
drop table if exists t_ai_retry;
--enable_warnings
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');

# ---------------------------------------------------------------------------
# local mock AI service, logical model and endpoint
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --stop-if-running
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --seed 20250101 --dim 4 > /tmp/ai_column_mock.log 2>&1 &
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --wait-ready
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --reset

call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'mock_doc_model', '{
    "type": "completion",
    "model_name": "mock-complete"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
  'mock_doc_endpoint', '{
    "ai_model_name": "mock_doc_model",
    "url": "http://127.0.0.1:19120/v1/chat/completions",
    "access_key": "sk-mock",
    "request_model_name": "mock-complete",
    "provider": "openai"
  }');

# ---------------------------------------------------------------------------
# the table under test.  "status" is a real business column on purpose: it
# tests the rule "unquoted status is the AI column status pseudo column,
# `status` is the business column".
# ---------------------------------------------------------------------------
create table t_ai_retry (
  id       bigint primary key,
  content  varchar(8192),
  status   varchar(16),
  language varchar(32) AI COLUMN (
    AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=LANG]] Return only the language name. Content: ', content))
  ) WITH (sync_mode='async', max_retries=2)
);
show ai columns from t_ai_retry;

insert into t_ai_retry (id, content, status) values
  (1, '[[LANG=Japanese]] alpha', 'active'),
  (2, '[[LANG=English]] beta', 'active'),
  (3, '[[LANG=French]] #fail gamma', 'archived');

let $wait_condition = select count(*) = 2 from t_ai_retry where id in (1, 2) and language is not null;
--source mysql_test/include/wait_condition.inc
# row 3 keeps failing, give its automatic retries time to reach the terminal state
--sleep 3
select id, language, status from t_ai_retry order by id;

# ---------------------------------------------------------------------------
# 1. RETRY FAILED AI COLUMN (no WHERE): only the FAILED row is re-queued
# ---------------------------------------------------------------------------
alter table t_ai_retry retry failed ai column language;
--sleep 3
select id, language, status from t_ai_retry order by id;

# ---------------------------------------------------------------------------
# 2. RETRY AI COLUMN (no FAILED, no WHERE): every row is re-queued
# ---------------------------------------------------------------------------
alter table t_ai_retry retry ai column language;
let $wait_condition = select count(*) = 2 from t_ai_retry where id in (1, 2) and language is not null;
--source mysql_test/include/wait_condition.inc
--sleep 3
select id, language, status from t_ai_retry order by id;

# ---------------------------------------------------------------------------
# 3. RETRY FAILED AI COLUMN ... WHERE <primary key>
# ---------------------------------------------------------------------------
alter table t_ai_retry retry failed ai column language where id = 3;
--sleep 3
select id, language, status from t_ai_retry order by id;

# zero row retry: legal, affects nothing, raises nothing
alter table t_ai_retry retry failed ai column language where id = 999;
select count(*) from t_ai_retry where id = 999;
select id, language, status from t_ai_retry order by id;

# ---------------------------------------------------------------------------
# 4. the status pseudo column versus the real `status` column
# ---------------------------------------------------------------------------
# unquoted status is the AI column status: READY rows are re-queued
alter table t_ai_retry retry ai column language where status = 'READY';
let $wait_condition = select count(*) = 2 from t_ai_retry where id in (1, 2) and language is not null;
--source mysql_test/include/wait_condition.inc
select id, language, status from t_ai_retry order by id;

# quoted `status` is the business column: only the archived row is touched
alter table t_ai_retry retry ai column language where `status` = 'archived';
--sleep 3
select id, language, status from t_ai_retry order by id;

# both in one condition: the pseudo column AND the business column
alter table t_ai_retry retry failed ai column language where status = 'FAILED' and `status` = 'archived';
--sleep 3
select id, language, status from t_ai_retry order by id;

# ---------------------------------------------------------------------------
# 5. illegal RETRY syntax
# ---------------------------------------------------------------------------
--error 1054
alter table t_ai_retry retry ai column no_such_column;
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 1210
alter table t_ai_retry retry ai column content;
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 1210
alter table t_ai_retry retry ai column status;
--error 1064
alter table t_ai_retry retry failed;
--error 1064
alter table t_ai_retry retry ai;
--error 1064
alter table t_ai_retry retry failed ai column;
--error 1146
alter table t_ai_retry_no_table retry ai column language;

# ---------------------------------------------------------------------------
# 6. strict read.  A not yet ready row (id = 50) makes every statement that
#    *references* the AI column fail, even when the predicate only selects
#    ready rows: the check is column level, not row level.
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --reset
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":5000}'
insert into t_ai_retry (id, content, status) values
  (50, '[[LANG=Korean]] pending row', 'active');

set session ai_column_strict_read = on;
show variables like 'ai_column_strict_read';

# projection: the predicate only selects the ready row 1
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 11116
select id, language from t_ai_retry where id = 1;
# predicate on the AI column
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 11116
select count(*) from t_ai_retry where language = 'Japanese';
# UPDATE whose WHERE references the AI column
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 11116
update t_ai_retry set status = 'touched' where language = 'Japanese';
# DELETE whose WHERE references the AI column
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 11116
delete from t_ai_retry where language = 'Japanese';
# ORDER BY / subquery references count as references too
--replace_regex /OB_AI_COLUMN.*/OB_AI_COLUMN <message>/
--error 11116
select id from t_ai_retry order by language limit 1;

# statements on ordinary columns only are not affected
select id, status from t_ai_retry where id = 1;
update t_ai_retry set status = 'touched' where id = 1;
delete from t_ai_retry where id = 9999;
select id, status from t_ai_retry order by id;

# ---------------------------------------------------------------------------
# 7. once every referenced row is ready, the same statements succeed again
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":0}'
# The readiness of the pending row can not be observed through the ai column while
# strict read is on (that is exactly what section 6 asserts), so strict read is
# switched off for the wait and back on for the assertions below. The row that fails
# permanently (id = 3) keeps a RUNNING task row while its retries are pending, so
# waiting for the task table to settle waits for its terminal state.
set session ai_column_strict_read = off;
let $wait_condition = select language = 'Korean' from t_ai_retry where id = 50;
--source mysql_test/include/wait_condition.inc
# the permanently failing row needs its bounded retries to be exhausted (a few
# seconds at most), after which it is FAILED and strict read ignores it
--sleep 10
set session ai_column_strict_read = on;
select id, language from t_ai_retry where id = 1;
select count(*) from t_ai_retry where language = 'Japanese' and id in (1, 2);
update t_ai_retry set status = 'touched' where language = 'Japanese' and id = 1;
select id, status from t_ai_retry where id = 1;
set session ai_column_strict_read = off;
select id, language from t_ai_retry where id = 1;

# ---------------------------------------------------------------------------
# self cleaning
# ---------------------------------------------------------------------------
--disable_warnings
drop table if exists t_ai_retry;
--enable_warnings
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --stop
