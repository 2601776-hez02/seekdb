#owner: ai-column
#owner group: seekdb
#description: AI COLUMN DML linkage and transaction consistency.
#             Task creation on INSERT (single and multi row), dependency column
#             UPDATE invalidates, irrelevant column UPDATE does not, primary key
#             UPDATE, DELETE of a row with a pending generation, transaction
#             ROLLBACK leaves no trace (no state change and no model call),
#             and a plain SELECT of a not yet ready AI column returns NULL.
#
#require: python3 (>= 3.7) on PATH
#require: AI_COLUMN_MOCK_PORT=19120 - TCP port of the local mock AI service
#         (default 19120; when you override it, also change the endpoint URLs
#         below, they are the only hard coded port literals)
#require: run from tools/deploy, e.g.
#         ./obd.sh mysqltest -n test --suite ai_function --test-set ai_column_t1_dml
#
# The mock is started and stopped by this case.  "no model call" is asserted by
# resetting the mock counters and then printing the one line mock state: every
# field has to stay 0.
#
--echo # expected output is generated on first run: mysqltest --record

connection default;

--let $wait_timeout= 60

# ---------------------------------------------------------------------------
# self cleaning
# ---------------------------------------------------------------------------
--disable_warnings
drop table if exists t_ai_dml;
--enable_warnings
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');

# ---------------------------------------------------------------------------
# local mock AI service, logical model and endpoint
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --stop-if-running
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --seed 20250101 --dim 4 > /tmp/ai_column_mock.log 2>&1 &
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --wait-ready
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --reset

call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'mock_doc_model', '{
    "type": "completion",
    "model_name": "mock-complete"
 }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT (
  'mock_doc_endpoint', '{
    "ai_model_name": "mock_doc_model",
    "url": "http://127.0.0.1:19120/v1/chat/completions",
    "access_key": "sk-mock",
    "request_model_name": "mock-complete",
    "provider": "openai"
  }');

# ---------------------------------------------------------------------------
# the table under test: two AI columns of one task group + one irrelevant column
# ---------------------------------------------------------------------------
create table t_ai_dml (
  id       bigint primary key,
  content  varchar(8192),
  note     varchar(64),
  language varchar(32) AI COLUMN (
    AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=LANG]] Return only the language name. Content: ', content))
  ) WITH (sync_mode='async', max_retries=3),
  tags json AI COLUMN (
    AI_COMPLETE('mock_doc_model', CONCAT('[[OUT=TAGS]] Tags for: ', content))
  ) WITH (sync_mode='async', max_retries=3)
);
show ai columns from t_ai_dml;

# ---------------------------------------------------------------------------
# 1. INSERT creates one generation task per row (single row)
# ---------------------------------------------------------------------------
insert into t_ai_dml (id, content, note) values
  (1, '[[LANG=Japanese]] [[TAGS=news,tech]] alpha', 'n1');

# ---------------------------------------------------------------------------
# 2. INSERT creates one generation task per row (multi row batch)
# ---------------------------------------------------------------------------
insert into t_ai_dml (id, content, note) values
  (2, '[[LANG=English]] [[TAGS=sports]] beta', 'n2'),
  (3, '[[LANG=French]] [[TAGS=music]] gamma', 'n3');

# both AI columns of a row become visible together
let $wait_condition = select count(*) = 0 from t_ai_dml where id in (1, 2, 3) and (language is null or tags is null);
--source mysql_test/include/wait_condition.inc
select id, language, json_length(tags) from t_ai_dml order by id;

# ---------------------------------------------------------------------------
# 3. UPDATE of a dependency column invalidates: value becomes NULL, status
#    PENDING, srcver is bumped (the row is regenerated).
#    A slow model makes the NULL window observable.
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":1500}'
update t_ai_dml set content = '[[LANG=German]] [[TAGS=update]] delta' where id = 1;
select id, language, tags from t_ai_dml where id = 1;
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":0}'
let $wait_condition = select language = 'German' from t_ai_dml where id = 1;
--source mysql_test/include/wait_condition.inc
select id, language, json_length(tags) from t_ai_dml where id = 1;

# ---------------------------------------------------------------------------
# 4. UPDATE of an irrelevant column neither invalidates the AI columns nor
#    changes the srcver: no new task, therefore no model call.
#    (srcver itself is only visible on the hidden __ai_srcver_<c> column; the
#    model call counter is the observable proxy used here.)
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --reset
update t_ai_dml set note = 'irrelevant update' where id = 2;
--sleep 2
select id, note, language, json_length(tags) from t_ai_dml where id = 2;
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --print-state

# ---------------------------------------------------------------------------
# 5. UPDATE of the primary key: the row must be reachable and consistent under
#    the new key and must never keep a stale value.
#    The design rebuilds the generation task for the new row key; an
#    implementation that keeps the derived value (the dependency columns did not
#    change) is accepted too, so the assertion is "no stale value under the new
#    key" rather than "the row must be regenerated".
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --reset
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":1500}'
update t_ai_dml set id = 101 where id = 3;
select count(*) from t_ai_dml where id = 3;
select count(*) from t_ai_dml where id = 101 and (language is null or language = 'French');
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":0}'
let $wait_condition = select language = 'French' from t_ai_dml where id = 101;
--source mysql_test/include/wait_condition.inc
select id, language, json_length(tags) from t_ai_dml where id = 101;

# ---------------------------------------------------------------------------
# 6. DELETE of a row whose generation is still pending: the row must not come
#    back when the late result is published
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":2000}'
insert into t_ai_dml (id, content, note) values
  (200, '[[LANG=Italian]] [[TAGS=doomed]] epsilon', 'n200');
delete from t_ai_dml where id = 200;
select count(*) from t_ai_dml where id = 200;
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":0}'
--sleep 4
select count(*) from t_ai_dml where id = 200;

# ---------------------------------------------------------------------------
# 7. transaction ROLLBACK leaves no trace: no AI value change, no task, no
#    model call
# ---------------------------------------------------------------------------
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --reset
begin;
insert into t_ai_dml (id, content, note) values
  (300, '[[LANG=Spanish]] [[TAGS=rollback]] zeta', 'n300');
update t_ai_dml set content = '[[LANG=Russian]] [[TAGS=rolled]] eta' where id = 1;
rollback;
select count(*) from t_ai_dml where id = 300;
select id, content, language from t_ai_dml where id = 1;
--sleep 2
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --print-state

# ---------------------------------------------------------------------------
# 8. SELECT of a not yet ready AI column returns NULL when
#    ai_column_strict_read is OFF (the default)
# ---------------------------------------------------------------------------
show variables like 'ai_column_strict_read';
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":1500}'
insert into t_ai_dml (id, content, note) values
  (400, '[[LANG=Korean]] [[TAGS=pending]] theta', 'n400');
select id, language, tags from t_ai_dml where id = 400;
select count(*) from t_ai_dml where id = 400 and language is null and tags is null;
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --config '{"delay_ms":0}'
let $wait_condition = select language = 'Korean' from t_ai_dml where id = 400;
--source mysql_test/include/wait_condition.inc
select id, language, json_length(tags) from t_ai_dml where id = 400;

# ---------------------------------------------------------------------------
# self cleaning
# ---------------------------------------------------------------------------
--disable_warnings
drop table if exists t_ai_dml;
--enable_warnings
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('mock_doc_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('mock_doc_model');
--exec python3 ./mysql_test/test_suite/ai_function/include/ai_column_mock.py --stop
