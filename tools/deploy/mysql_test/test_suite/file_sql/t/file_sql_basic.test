# The file SQL table functions read local files directly: read_csv, read_json /
# read_ndjson and read_parquet infer the column set from the file, and glob()
# only discovers files.  The feature is off by default and every path must stay
# inside secure_file_priv.
#
# The fixtures are copied to /tmp/seekdb_file_sql so that the expected output is
# machine independent.  secure_file_priv defaults to "/" in seekdb; narrow it to
# a parent of that directory instead if the instance was hardened.
#
# The expected output was derived from the specification; re-record it with
# --record on a live instance when the baseline changes.

--disable_warnings
DROP TABLE IF EXISTS file_sql_t;
--enable_warnings

--source mysql_test/test_suite/file_sql/include/deploy.inc

--let $file_sql_dir = /tmp/seekdb_file_sql

--echo #
--echo # 1. the switch is off by default
--error 1235
SELECT * FROM read_csv('/tmp/seekdb_file_sql/basic.csv');

SET SESSION enable_file_sql = 1;

--echo #
--echo # 2. CSV: header, type inference, quoting, NULL marker
SELECT * FROM read_csv('/tmp/seekdb_file_sql/basic.csv', nullstr = 'NA');
SELECT k, LENGTH(v) AS len FROM read_csv('/tmp/seekdb_file_sql/quoted.csv') ORDER BY k;

--echo #
--echo # 3. single file SQL: projection, filter, aggregate, order, limit
SELECT region, COUNT(*) AS cnt, SUM(amount) AS total
  FROM read_csv('/tmp/seekdb_file_sql/sales.csv') GROUP BY region ORDER BY region;
SELECT name FROM read_csv('/tmp/seekdb_file_sql/basic.csv', nullstr = 'NA')
  WHERE score > 1 ORDER BY id LIMIT 1;

--echo #
--echo # 4. JSONL: field union, missing fields and type conflicts
SELECT * FROM read_json('/tmp/seekdb_file_sql/people.jsonl') ORDER BY id;
SELECT COUNT(*) AS cnt FROM read_ndjson('/tmp/seekdb_file_sql/people.jsonl');

--echo #
--echo # 5. Parquet: footer schema, optional columns, snappy pages
SELECT * FROM read_parquet('/tmp/seekdb_file_sql/basic.parquet') ORDER BY id;
SELECT COUNT(*) AS cnt FROM read_parquet('/tmp/seekdb_file_sql/basic.parquet');

--echo #
--echo # 6. glob() only discovers files
SELECT * FROM glob('/tmp/seekdb_file_sql/*.csv');

--echo #
--echo # 7. JOIN across two files stays in the seekdb plan
SELECT p.name, SUM(o.amount) AS total
  FROM read_json('/tmp/seekdb_file_sql/people.jsonl') AS p
  INNER JOIN read_json('/tmp/seekdb_file_sql/orders.jsonl') AS o ON p.id = o.person_id
  GROUP BY p.name ORDER BY p.name;

--echo #
--echo # 8. diagnostics
--error 1017
SELECT * FROM read_csv('/tmp/seekdb_file_sql/no_such_file.csv');
--error 1235
SELECT * FROM read_csv('/tmp/seekdb_file_sql/basic.csv', sample_size = 100);
--error 1582
SELECT * FROM read_csv();

SET SESSION enable_file_sql = 0;
--error 1235
SELECT * FROM glob('/tmp/seekdb_file_sql/*.csv');

--source mysql_test/test_suite/file_sql/include/cleanup.inc
